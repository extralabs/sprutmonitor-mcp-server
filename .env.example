# SprutMonitor MCP — скопируйте в .env и поправьте.
#
# Сайт: https://sprutmonitor.ru/
# Документация продукта: https://sprutmonitor.ru/docs2/
# Кабинет: https://app.sprutmonitor.ru/
# Каталог API в кабинете: https://app.sprutmonitor.ru/api/

# Адрес Web-api сервера СпрутМонитор, в т.ч. облако.
# Со схемой и префиксом, например:
#   https://cloud.sprutmonitor.ru/v3
#   http://192.168.1.8:82/MonitorServer/
SPRUT_API_BASE=https://cloud.sprutmonitor.ru/v3

# Логин и пароль аккаунта СпрутМонитор https://app.sprutmonitor.ru/
# или дополнительного пользователя (вкладка Настройки - Доступ).
# Ниже — демо.
SPRUT_EMAIL=demo@sprutmonitor.ru
SPRUT_PASSWORD=demo

# Необязательно: глубина по умолчанию (дни), если tool не получил date_from / period
# SPRUT_DEFAULT_DAYS=1

# Необязательно: какие tools регистрировать — all | core | console | core,console
# (console всё равно включает core)
# SPRUT_TOOLSETS=all
