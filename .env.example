# SprutMonitor MCP — скопируйте в .env и поправьте.
# Не кладите боевые пароли в конфиг и не коммитьте их.
# Для своего кабинета лучше отдельный оператор с урезанными правами.
#
# Сайт: https://sprutmonitor.ru/
# Документация продукта: https://sprutmonitor.ru/docs/
# Кабинет: https://app.sprutmonitor.ru/
# Каталог API в кабинете: https://app.sprutmonitor.ru/api/

# База API (serverBase из spm-config.json, не адрес сайта кабинета).
# Облако: префикс /v3 входит в базу. Клиент сам дописывает /api/...
# Локальная установка: сюда целиком serverBase, со схемой и префиксом вроде /MonitorServer.
SPRUT_API_BASE=https://cloud.sprutmonitor.ru/v3

# Ниже — публичный демо-вход, только для локальной проверки.
# Свой кабинет: почта и пароль оператора здесь или в блоке env конфига Cursor
# (см. docs/hosts.md).
SPRUT_EMAIL=demo@sprutmonitor.ru
SPRUT_PASSWORD=demo

# Необязательно: глубина по умолчанию (дни), если tool не получил date_from / period
# SPRUT_DEFAULT_DAYS=1

# Необязательно: какие tools регистрировать — all | core | console | core,console
# (console всё равно включает core)
# SPRUT_TOOLSETS=all
